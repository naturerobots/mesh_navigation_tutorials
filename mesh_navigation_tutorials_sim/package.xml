<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mesh_navigation_tutorials_sim</name>
  <version>3.0.0</version>
  <description>
    This package contains simulation environments and robot models for the mesh navigation tutorials. 
    It provides Gazebo worlds, URDFs, and nodes to facilitate 3D navigation experiments in simulation.
  </description>
  
  <maintainer email="matthias.holoch@naturerobots.com">Matthias Holoch</maintainer>
  <maintainer email="amock@uos.de">Alexander Mock</maintainer>
  
  <license>BSD-3-Clause</license>

  <url type="website">https://naturerobots.github.io/mesh_navigation_docs/tutorials</url>
  <url type="repository">https://github.com/naturerobots/mesh_navigation_tutorials</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_copyright</test_depend>
  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_pep257</test_depend>
  <test_depend>ament_cmake_uncrustify</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
    <gazebo_ros gazebo_model_path="${prefix}/.." />
  </export>
</package>
